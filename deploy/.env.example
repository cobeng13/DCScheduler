# HTTPS hostname configured in the existing Cloudflare Tunnel.
PUBLIC_ORIGIN=https://scheduler.example.edu
APP_PORT=8004
# Use the apps-server LAN IP when the tunnel connector runs on another VM.
BIND_ADDRESS=127.0.0.1
APP_IMAGE=camp-scheduler:local
POSTGRES_IMAGE=postgres:16-bookworm
# Prefer a mounted backup location outside the app host.
BACKUP_DIR=/mnt/camp-backups/scheduler
RETENTION_DAYS=30

# Minimum free MB on project, Docker data, and backup filesystems before changes.
MIN_FREE_DISK_MB=4096

# Admin browser backups use a fixed 12 MiB limit and private /tmp storage.
# Keep the daily native PostgreSQL backup workflow above for off-host recovery.
